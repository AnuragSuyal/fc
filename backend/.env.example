# ────────────────────────────────────────────────────────────
# Friend Circle – Backend Environment Variables
# Copy this file to .env and fill in real values.
# Generate JWT secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=*

# MongoDB
MONGODB_URI=mongodb://localhost:27017/friendcircle

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_HEX
REFRESH_SECRET=CHANGE_ME_ANOTHER_RANDOM_64_CHAR_HEX

# LiveKit  (https://livekit.io)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880

# Twilio OTP (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stripe  (https://stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth  (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth  (https://developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Frontend deep-link / OAuth redirect
FRONTEND_URL=friendcircle://auth




