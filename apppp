    setState(() => _isLoading = true);

    try {
      // Capture context-dependant refs before async gap
      final authProvider = Provider.of<AuthProvider>(context, listen: false);

      // Open browser for OAuth
      // Use 10.0.2.2 for Android emulator
      const baseUrl = 'http://10.0.2.2:5000/api/auth';

      // Add a timestamp cache-buster so Chrome doesn't aggressively reuse
      // the old 302 redirect containing the fake 'your_google_client_id'.
      final timestamp = DateTime.now().millisecondsSinceEpoch;
      final url = '$baseUrl/$provider?t=$timestamp';

      final result = await FlutterWebAuth2.authenticate(
        url: url,
        callbackUrlScheme: 'friendcircle',
      );

      final token = Uri.parse(result).queryParameters['token'];
      if (token != null && token.isNotEmpty) {
        await authProvider.handleSocialToken(token);

        if (!mounted) return;
        Navigator.pushReplacementNamed(context, '/home');
