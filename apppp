class ChatScreen extends StatefulWidget {
  final String userId;
  final String username;
  final String? avatar;

  const ChatScreen({
    super.key,
    required this.userId,
    required this.username,
    this.avatar,
  });

  @override
  State<ChatScreen> createState() => _ChatScreenState();
}

class _ChatScreenState extends State<ChatScreen> {
  final TextEditingController _messageController = TextEditingController();
  final ScrollController _scrollController = ScrollController();
  List<MessageModel> _messages = [];
  bool _isLoading = true;
  bool _isSending = false;
  bool _isTyping = false;
  Timer? _typingTimer;
  int _currentPage = 1;
  bool _hasMore = true;

  @override
  void initState() {
    super.initState();
    _loadMessages();
    _setupSocketListeners();
  }

  @override
  void dispose() {
    _messageController.dispose();
    _scrollController.dispose();
    _typingTimer?.cancel();
    final socket = SocketService.socket;
    socket?.off('dm:received');
    socket?.off('typing');
    socket?.off('message:reaction');
    super.dispose();
  }

  Future<void> _loadMessages({bool reset = false}) async {
    if (reset) {
      _currentPage = 1;
      _hasMore = true;
    }

    if (!_hasMore) return;

    setState(() => _isLoading = _currentPage == 1);

    final result = await MessageService.getDirectMessages(
      widget.userId,
      page: _currentPage,
    );

    if (!mounted) return;

    setState(() {
      if (_currentPage == 1) {
        _messages = result['messages'];
      } else {
        _messages = [...result['messages'], ..._messages];
      }

      _hasMore = result['pagination']?['pages'] > _currentPage;
      _isLoading = false;

      // Scroll to bottom on first load
      if (_currentPage == 1 && _messages.isNotEmpty) {
        WidgetsBinding.instance.addPostFrameCallback((_) {
          _scrollToBottom();
        });
      }
    });
  }

  void _setupSocketListeners() {
    final socket = SocketService.socket;

    socket?.on('dm:received', (data) {
      // Need to safely parse json based on the incoming structure map
      if (data == null || data['message'] == null) return;
      final message = MessageModel.fromJson(data['message']);
      if (message.senderId == widget.userId ||
          message.senderId ==
              Provider.of<AuthProvider>(context, listen: false).user?.id) {
        setState(() {
          _messages.insert(0, message);
        });
        _scrollToBottom();
        if (message.senderId == widget.userId) {
          _markAsRead();
        }
      }
    });

    socket?.on('typing', (data) {
      if (data != null && data['userId'] == widget.userId) {
        setState(() => _isTyping = data['isTyping'] ?? false);
      }
    });

    socket?.on('message:reaction', (data) {
      if (data != null && data['messageId'] != null) {
        _updateMessageReaction(
          data['messageId'],
          data['userId'],
          data['reaction'],
        );
      }
    });
  }

  void _updateMessageReaction(
      String messageId, String userId, String reaction) {
    setState(() {
      final index = _messages.indexWhere((m) => m.id == messageId);
      if (index != -1) {
        final message = _messages[index];
        final existingIndex = message.reactions
            .indexWhere((r) => r.userId == userId && r.reaction == reaction);

        if (existingIndex != -1) {
          message.reactions.removeAt(existingIndex);
        } else {
          message.reactions.add(Reaction(
            userId: userId,
            reaction: reaction,
            createdAt: DateTime.now(),
          ));
        }
      }
    });
  }

  void _scrollToBottom() {
    if (_scrollController.hasClients) {
      _scrollController.animateTo(
        0.0, // Because this layout is `reverse: true`
        duration: const Duration(milliseconds: 300),
        curve: Curves.easeOut,
      );
    }
  }

  void _handleTyping(String value) {
    if (value.isNotEmpty) {
      if (!_isTyping) {
        SocketService.socket?.emit('typing', {
          'recipientId': widget.userId,
          'isTyping': true,
        });
      }

      _typingTimer?.cancel();
      _typingTimer = Timer(const Duration(seconds: 2), () {
        SocketService.socket?.emit('typing', {
          'recipientId': widget.userId,
          'isTyping': false,
        });
      });
    }
  }

  Future<void> _sendMessage() async {
    if (_messageController.text.trim().isEmpty) return;

    setState(() => _isSending = true);

    final content = _messageController.text.trim();
    // Optimistic UI updates could go here
    _messageController.clear();

    final message = await MessageService.sendDirectMessage(
      recipientId: widget.userId,
      content: content,
    );

    if (message != null && mounted) {
      // Typically if socket echo happens we wouldn't double add, but for DM sending the socket might only go to recipient.
      // If our API returns it, we can insert it.
      setState(() {
        // Only insert if it's not already there (if socket delivered it first)
        if (!_messages.any((m) => m.id == message.id)) {
          _messages.insert(0, message);
        }
      });
      _scrollToBottom();
    }

    if (mounted) {
      setState(() => _isSending = false);
    }
  }

  Future<void> _handleReaction(String messageId, String reaction) async {
    await MessageService.addReaction(messageId, reaction);
  }

  Future<void> _handleDeleteMessage(String messageId) async {
    final confirm = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Delete Message'),
        content: const Text('Are you sure you want to delete this message?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: const Text('Cancel'),
          ),
          TextButton(
            onPressed: () => Navigator.pop(context, true),
            child: const Text('Delete'),
          ),
        ],
      ),
    );

    if (confirm == true) {
      final success = await MessageService.deleteMessage(messageId);
      if (success && mounted) {
        setState(() {
          _messages.removeWhere((m) => m.id == messageId);
        });
      }
    }
  }

