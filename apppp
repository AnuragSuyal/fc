  Future<void> _joinRoom() async {
    setState(() {
      _isJoining = true;
      _errorMessage = null;
    });

    try {
      final updatedRoom = await RoomService.joinRoom(
        _room.id,
        password: _room.isPrivate ? _passwordController.text : null,
      );

      if (!mounted) return;

      if (updatedRoom != null) {
        // Emit formal join event
        SocketService.socket?.emit('room:join', {'roomId': _room.id});

        setState(() {
          _room = updatedRoom;
          _isJoining = false;
        });

        _connectToVoice();

        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('Joined room successfully!'),
            backgroundColor: AppColors.successGreen,
          ),
        );
      }
    } catch (e) {
      if (!mounted) return;
      setState(() {
        _errorMessage = e.toString().replaceFirst('Exception: ', '');
        _isJoining = false;
      });
    }
  }

  bool _isUserInRoom(String userId) {
    return _room.participants.any((p) {
      if (p.user != null) {
        return p.user!.id == userId;
      }
      return p.userId == userId;
    });
  }

