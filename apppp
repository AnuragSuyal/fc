}

class _WeddingScreenState extends State<WeddingScreen> with SingleTickerProviderStateMixin {
  late TabController _tabs;
  Map<String, dynamic>? _wedding;
  List<dynamic> _rankings = [];
  List<Map<String, dynamic>> _rings = [];
  bool _loading = true;
  StreamSubscription? _weddingSub;

  @override
  void initState() {
    super.initState();
    _tabs = TabController(length: 3, vsync: this);
    _load();
    _weddingSub = SocketService.weddingStream.listen(_onWeddingEvent);
  }

  @override
  void dispose() {
    _tabs.dispose();
    _weddingSub?.cancel();
    super.dispose();
  }

  Future<void> _load() async {
    setState(() => _loading = true);
    try {
      final results = await Future.wait([
        WeddingService.getMyWedding(),
        WeddingService.getCoupleRankings(),
        WeddingService.getRings(),
      ]);
      if (!mounted) return;
      setState(() {
        _wedding  = results[0] as Map<String, dynamic>?;
        _rankings = results[1] as List;
        _rings    = List<Map<String, dynamic>>.from(results[2] as List);
        _loading  = false;
      });
    } catch (_) { if (mounted) setState(() => _loading = false); }
  }

  void _onWeddingEvent(Map<String, dynamic> data) {
    if (!mounted) return;
    final type = data['_eventType'] as String? ?? '';
    if (type == 'proposal') {
      _showProposalDialog(data);
    } else if (type == 'accepted') {
      _showSnack('💍 Your proposal was accepted! Congratulations!', Colors.pink);
      _load();
    } else if (type == 'rejected') {
      _showSnack('Proposal declined.', Colors.grey);
      _load();
    } else if (type == 'divorced') {
      _showSnack('You have been divorced.', Colors.red);
      _load();
    } else if (type == 'blessing') {
      _showSnack('💕 ${data['from']?['username'] ?? 'Someone'} sent a blessing!', Colors.pink);
    }
  }

  void _showProposalDialog(Map<String, dynamic> data) {
    final from      = data['from'] as Map<String, dynamic>? ?? {};
    final ring      = data['ring'] as Map<String, dynamic>? ?? {};
    final weddingId = data['weddingId']?.toString() ?? '';

    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (_) => AlertDialog(
        title: const Text('💍 Marriage Proposal!'),
        content: Column(mainAxisSize: MainAxisSize.min, children: [
          Text('${from['username'] ?? 'Someone'} is proposing to you!'),
          const SizedBox(height: 12),
          Text('With: ${ring['icon'] ?? '💍'} ${ring['name'] ?? 'a ring'}',
              style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
        ]),
        actions: [
          TextButton(
            onPressed: () { Navigator.pop(context); WeddingService.reject(weddingId).then((_) => _load()); },
            child: const Text('Decline', style: TextStyle(color: Colors.red)),
          ),
          ElevatedButton(
            onPressed: () { Navigator.pop(context); WeddingService.accept(weddingId).then((_) => _load()); },
            style: ElevatedButton.styleFrom(backgroundColor: Colors.pink),
            child: const Text('Accept 💕', style: TextStyle(color: Colors.white)),
          ),
        ],
      ),
    );
  }

  void _showSnack(String msg, Color bg) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(msg), backgroundColor: bg));
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('💍 Wedding'),
        bottom: TabBar(controller: _tabs, tabs: const [Tab(text: 'My Status'), Tab(text: 'Rankings'), Tab(text: 'Rings')]),
      ),
      body: _loading
          ? const Center(child: CircularProgressIndicator())
          : TabBarView(controller: _tabs, children: [
              _buildStatus(),
              _buildRankings(),
              _buildRings(),
            ]),
    );
  }

  Widget _buildStatus() {
    final married = _wedding?['married'] == true;
    final partner = _wedding?['partner'] as Map<String, dynamic>?;

    if (!married) {
      return Center(child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
        const Text('💔', style: TextStyle(fontSize: 64)),
