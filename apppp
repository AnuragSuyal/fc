            password,
            ...(phone ? { phone } : {})
        });

        await user.save();

        const { token, refreshToken } = generateTokens(user._id);

        // Store refresh token in Redis for session validation
        const redis = req.app.get('redis');
        if (redis) {
            await redis.set(`session:${user._id}`, refreshToken, { EX: 604800 });
        }

        res.status(201).json({
