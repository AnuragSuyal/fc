  Participant? _getParticipantAtSeat(int seatIndex) {
    // Basic mapping for demo: first 8 participants (excluding host) go to seats
    final nonHosts =
        _room.participants.where((p) => p.userId != _room.hostId).toList();

    if (seatIndex - 1 < nonHosts.length) {
      return nonHosts[seatIndex - 1];
    }
    return null;
  }

  int _getMySeatIndex() {
    final authProvider = Provider.of<AuthProvider>(context, listen: false);
    final userId = authProvider.user?.id;
    if (userId == null) return -1;

    if (userId == _room.hostId) return 0; // Host seat is 0

    final nonHosts =
        _room.participants.where((p) => p.userId != _room.hostId).toList();
    for (int i = 0; i < nonHosts.length; i++) {
      if (nonHosts[i].userId == userId) return i + 1;
    }

    return -1;
  }

