              Tab(text: 'My Groups'),
              Tab(text: 'Discover'),
              Tab(text: 'Leaderboard'),
            ],
          ),
        ),
        Expanded(
          child: _isLoading
              ? const Center(child: CircularProgressIndicator())
              : TabBarView(
                  controller: _tabController,
