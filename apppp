  Future<void> _sendMessage() async {
    if (_messageController.text.trim().isEmpty) return;

    final content = _messageController.text;
    _messageController.clear();
    Navigator.pop(context);

    try {
      if (_isOnlyEmoji(content)) {
        final user = Provider.of<AuthProvider>(context, listen: false).user;
        final seatIndex = user != null ? _getUserSeatIndex(user.id) : -1;
        SocketService.socket?.emit('room:message', {
          'roomId': _room.id,
          'userId': user?.id,
          'content': content,
          'type': 'emoji',
          'emojis': _extractEmojis(content),
          'seatIndex': seatIndex,
        });
      } else {
        SocketService.sendRoomMessage(roomId: _room.id, content: content);
      }
    } catch (e) {
      debugPrint('Error sending message: $e');
    }
  }

  bool _isOnlyEmoji(String text) {
    if (text.isEmpty) return false;
    final emojiRegex = RegExp(
        r'(\u00a9|\u00ae|[\u2000-\u3300]|\ud83c[\ud000-\udfff]|\ud83d[\ud000-\udfff]|\ud83e[\ud000-\udfff])+');
    final match = emojiRegex.stringMatch(text);
    return match == text;
  }

  List<String> _extractEmojis(String text) {
    final emojiRegex = RegExp(
        r'(\u00a9|\u00ae|[\u2000-\u3300]|\ud83c[\ud000-\udfff]|\ud83d[\ud000-\udfff]|\ud83e[\ud000-\udfff])');
    return emojiRegex.allMatches(text).map((m) => m.group(0)!).toList();
  }

  Color _getTypeColor(String type) {
    switch (type.toLowerCase()) {
      case 'voice':
        return Colors.blueAccent;
      case 'music':
        return Colors.purpleAccent;
      case 'video':
        return Colors.redAccent;
      case 'auction':
        return Colors.orangeAccent;
      case 'game':
        return Colors.greenAccent;
      case 'chats':
        return Colors.tealAccent;
      default:
        return Colors.blueAccent;
    }
  }

