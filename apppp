import 'dart:async';
import 'package:flutter/material.dart';
import '../services/auth_service.dart';
import '../models/user_model.dart';
import '../services/socket_service.dart';
import '../services/wallet_service.dart';

class AuthProvider extends ChangeNotifier {
  UserModel? _user;
  bool       _isLoading = false;
  String?    _error;
  int        _pendingFriendRequests = 0;

  UserModel? get user                   => _user;
  bool       get isLoading              => _isLoading;
  String?    get error                  => _error;
  bool       get isAuthenticated        => _user != null;
  int        get pendingFriendRequests  => _pendingFriendRequests;

  final List<StreamSubscription> _subs = [];

  // ── Auth flows ──────────────────────────────────────────────────────────────
  Future<void> handleSocialToken(String token) async {
    _setLoading(true);
    try {
      await AuthService.saveToken(token);
      await loadUser();
    } catch (_) { _setError('Failed to load user profile'); }
  }

  Future<bool> login(String email, String password) async {
    _setLoading(true);
    try {
      final res = await AuthService.login(email: email, password: password);
      _user = UserModel.fromJson(res['user']);
      await _initSocket();
      _setLoading(false);
      return true;
    } catch (e) { _setError(e.toString().replaceFirst('Exception: ', '')); return false; }
  }

  Future<bool> register({required String username, required String email, required String password}) async {
    _setLoading(true);
    try {
      final res = await AuthService.register(username: username, email: email, password: password);
      _user = UserModel.fromJson(res['user']);
      await _initSocket();
      _setLoading(false);
      return true;
    } catch (e) { _setError(e.toString().replaceFirst('Exception: ', '')); return false; }
  }

  Future<bool> guestLogin() async {
    _setLoading(true);
    try {
      final res = await AuthService.guestLogin();
      _user = UserModel.fromJson(res['user']);
      await _initSocket();
      _setLoading(false);
      return true;
    } catch (e) { _setError(e.toString().replaceFirst('Exception: ', '')); return false; }
  }

  Future<void> logout() async {
    await AuthService.logout();
    _cancelSubs();
    await SocketService.dispose();
    _user = null;
    _pendingFriendRequests = 0;
    notifyListeners();
  }

  Future<void> loadUser() async {
    final loggedIn = await AuthService.isLoggedIn();
    if (!loggedIn) return;
    _setLoading(true);
    try {
      final userData = await AuthService.getCurrentUser();
      _user = UserModel.fromJson(userData);
      await _initSocket();
    } catch (_) { await AuthService.logout(); }
    finally { _setLoading(false); }
  }

  // ── Socket setup ────────────────────────────────────────────────────────────
  Future<void> _initSocket() async {
    await SocketService.init();
    _cancelSubs();
    _subs.add(SocketService.balanceStream.listen(_onBalance));
    _subs.add(SocketService.levelUpStream.listen(_onLevelUp));
    _subs.add(SocketService.friendStream.listen(_onFriend));
  }

  void _onBalance(Map<String, dynamic> d) => updateProfile(
    coins: _toInt(d['coins']), gems: _toInt(d['gems']),
    xp:    _toInt(d['xp']),   level: _toInt(d['level']),
  );

  void _onLevelUp(Map<String, dynamic> d) => updateProfile(
    level: _toInt(d['newLevel']), xp: _toInt(d['xp']),
  );

  void _onFriend(Map<String, dynamic> d) {
    final type = d['_eventType'] as String? ?? '';
    if (type == 'friend_request_received') {
      _pendingFriendRequests++;
      notifyListeners();
    } else if (type == 'friend_request_accepted' || type == 'friend_request_rejected') {
      notifyListeners();
    }
  }

  // ── Profile helpers ─────────────────────────────────────────────────────────
  void updateProfile({int? coins, int? gems, int? xp, int? level, int? vipLevel}) {
    if (_user == null) return;
    _user = _user!.copyWith(
      coins:    coins,
      gems:     gems,
      xp:       xp,
      level:    level,
      vipLevel: vipLevel,
    );
    notifyListeners();
  }

  void updateBalance({int? coins, int? gems}) => updateProfile(coins: coins, gems: gems);

  void updateAvatar(String url) {
    if (_user == null) return;
    _user = _user!.copyWith(avatar: url);
    notifyListeners();
  }

  Future<void> refreshBalance() async {
    try {
      final b = await WalletService.getBalance();
      updateProfile(coins: b['coins'], gems: b['gems'], vipLevel: b['vipLevel']);
    } catch (_) {}
  }

  void clearPendingFriendRequests() {
    _pendingFriendRequests = 0;
    notifyListeners();
  }

  Future<String?> sendOTP(String phone) async {
    _setLoading(true);
    try {
      final res = await AuthService.sendOTP(phone);
      _setLoading(false);
      return res['otp']?.toString();
    } catch (e) {
      _setError(e.toString().replaceFirst('Exception: ', ''));
      rethrow;
    }
  }

  void clearError() { _error = null; notifyListeners(); }

  // ── Internals ───────────────────────────────────────────────────────────────
  void _setLoading(bool v) { _isLoading = v; if (v) _error = null; notifyListeners(); }
  void _setError(String m) { _isLoading = false; _error = m; notifyListeners(); }
  void _cancelSubs() { for (final s in _subs) s.cancel(); _subs.clear(); }

  static int? _toInt(dynamic v) {
    if (v == null) return null;
    if (v is int)  return v;
    if (v is num)  return v.toInt();
    return null;
  }

  @override
  void dispose() { _cancelSubs(); super.dispose(); }
}





