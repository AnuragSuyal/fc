import 'dart:convert';
import 'dart:io';
import 'package:http/http.dart' as http;
import 'package:http_parser/http_parser.dart';
import '../utils/constants.dart';
import 'auth_service.dart';

class UploadService {
  static String get baseUrl => AppConfig.baseUrl;

  static Future<Map<String, dynamic>?> uploadAvatar(File imageFile) =>
      _upload(imageFile, 'avatar', '/uploads/avatar');

  static Future<Map<String, dynamic>?> uploadImage(File imageFile) =>
      _upload(imageFile, 'image', '/uploads/image');

  static Future<Map<String, dynamic>?> _upload(File file, String field, String endpoint) async {
    try {
      final token = await AuthService.getToken();
      if (token == null) return null;

      final ext  = file.path.split('.').last.toLowerCase();
      const mimeMap = {'jpg': 'jpeg', 'jpeg': 'jpeg', 'png': 'png', 'gif': 'gif', 'webp': 'webp'};
      final sub  = mimeMap[ext] ?? 'jpeg';

      final req = http.MultipartRequest('POST', Uri.parse('$baseUrl$endpoint'))
        ..headers['Authorization'] = 'Bearer $token'
        ..files.add(await http.MultipartFile.fromPath(field, file.path, contentType: MediaType('image', sub)));

      final streamed = await req.send().timeout(const Duration(seconds: 30));
      final response = await http.Response.fromStream(streamed);

      if (response.statusCode == 200) return json.decode(response.body);
      return null;
    } catch (_) {
      return null;
    }
  }
}





