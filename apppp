class _RoomDetailScreenState extends State<RoomDetailScreen> {
  late RoomModel _room;
  final bool _isLoading = false;
  bool _isJoining = false;
  String? _errorMessage;
  final TextEditingController _passwordController = TextEditingController();
  final TextEditingController _messageController = TextEditingController();
  final List<Map<String, dynamic>> _chatMessages = [];
  StreamSubscription? _messageSubscription;
  StreamSubscription? _updateSubscription;
  bool _isMuted = true;
  bool _isSpeakerOn = true;
  final VoiceService _voiceService = VoiceService();
  Timer? _heartbeatTimer;

  // Global Keys for mapping seat positions to global overlay
  final Map<int, GlobalKey> _seatKeyMap = {
    for (int i = 0; i <= 8; i++) i: GlobalKey(),
  };

  @override
  void initState() {
    super.initState();
    _room = widget.room;
    _joinSocketRoom();

    // Initial system messages (Inspired by screenshot)
    _chatMessages.add({
      'type': 'system',
      'content':
          'Welcome to Friend Circle Voice Room. Erotic, cursing and illegal contents are strictly forbidden in the voice room. We advocate healthy gaming and internet police officers will be cruising 24/7. Please report whenever you find any violations and abide by Regulations Of The Voice Room',
    });

    _chatMessages.add({
      'type': 'system',
      'content':
          'This room applies high quality mode. The tone quality will be improved and more traffic will be consumed.',
    });

    _messageSubscription = SocketService.roomMessageStream.listen((data) {
      if (data['roomId'] == _room.id) {
        setState(() {
          _chatMessages.add(data);
          if (_chatMessages.length > 100) _chatMessages.removeAt(0);
        });
      }
    });

    _updateSubscription = SocketService.roomUpdateStream.listen((data) {
      if (data['id'] == _room.id || data['roomId'] == _room.id) {
        if (data['type'] == 'join') {
          _refreshRoom();
        } else {
          setState(() {
            _room = RoomModel.fromJson(data);
          });
        }
      }
    });

    WidgetsBinding.instance.addPostFrameCallback((_) {
      _initializeRoom();
      _startHeartbeat();
    });
  }

  void _startHeartbeat() {
    _heartbeatTimer?.cancel();
    _heartbeatTimer = Timer.periodic(const Duration(seconds: 30), (timer) {
      if (SocketService.socket?.connected == true) {
        SocketService.socket?.emit('room:heartbeat', {'roomId': _room.id});
      }
    });
  }

  void _initializeRoom() {
    final authProvider = Provider.of<AuthProvider>(context, listen: false);
    final userId = authProvider.user?.id ?? '';
    if (_isUserInRoom(userId)) {
      _connectToVoice();
    }
  }

  Future<void> _connectToVoice() async {
    try {
      final tokenResponse = await RoomService.getRoomToken(_room.id);
      final token = tokenResponse['token'];
      final serverUrl = tokenResponse['serverUrl'];

      await _voiceService.initAudio();
      final String effectiveUrl = serverUrl.replaceAll('localhost', '10.0.2.2');
      await _voiceService.connectToRoom(effectiveUrl, token);

      if (mounted) {
        setState(() {
          _isMuted = false;
          _isSpeakerOn = true;
        });
      }
    } catch (e) {
      debugPrint('Voice connection failed: $e');
    }
  }

