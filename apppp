const Wedding     = require('../models/Wedding');
const User        = require('../models/User');
const Transaction = require('../models/Transaction');

// Ring catalog – costs paid in coins
const RINGS = [
    { id: 'silver',   name: 'Silver Ring',   icon: '💍', rarity: 'common',    price: 500   },
    { id: 'gold',     name: 'Gold Ring',      icon: '💛', rarity: 'rare',      price: 2000  },
    { id: 'diamond',  name: 'Diamond Ring',   icon: '💎', rarity: 'epic',      price: 10000 },
    { id: 'eternal',  name: 'Eternal Ring',   icon: '✨', rarity: 'legendary', price: 50000 }
];

exports.getRings = (_req, res) => res.json(RINGS);

// @desc    Get my wedding status
exports.getMyWedding = async (req, res, next) => {
    try {
        const wedding = await Wedding.findOne({
            $or: [{ proposerId: req.userId }, { partnerId: req.userId }],
            status: { $in: ['pending', 'accepted', 'active'] }
        })
            .populate('proposerId', 'username avatar level vipLevel')
            .populate('partnerId',  'username avatar level vipLevel')
            .populate('ceremony.roomId', 'name roomId');

        if (!wedding) return res.json({ married: false });

        const partner = wedding.proposerId._id.toString() === req.userId
            ? wedding.partnerId
            : wedding.proposerId;

        res.json({ married: wedding.status === 'active', wedding, partner });
    } catch (error) { next(error); }
};

// @desc    Propose marriage
exports.propose = async (req, res, next) => {
    try {
        const { partnerId, ringId } = req.body;
        if (partnerId === req.userId) { const e = new Error('Cannot marry yourself'); e.status = 400; throw e; }

        const ring = RINGS.find(r => r.id === ringId);
        if (!ring) { const e = new Error('Invalid ring'); e.status = 400; throw e; }

        // Check existing wedding
        const existing = await Wedding.findOne({
            $or: [{ proposerId: req.userId }, { partnerId: req.userId }],
            status: { $in: ['pending', 'active'] }
        });
        if (existing) { const e = new Error('You are already married or have a pending proposal'); e.status = 400; throw e; }

        // Check partner not already married
        const partnerMarried = await Wedding.findOne({
            $or: [{ proposerId: partnerId }, { partnerId }],
            status: { $in: ['pending', 'active'] }
        });
        if (partnerMarried) { const e = new Error('Partner is already married or has a pending proposal'); e.status = 400; throw e; }

        // Deduct coins
        const proposer = await User.findOneAndUpdate(
            { _id: req.userId, coins: { $gte: ring.price } },
            { $inc: { coins: -ring.price } },
            { new: true }
        );
        if (!proposer) { const e = new Error('Insufficient coins'); e.status = 400; throw e; }

        const wedding = await Wedding.create({
            proposerId: req.userId, partnerId,
            ring: { name: ring.name, icon: ring.icon, rarity: ring.rarity, coinsSpent: ring.price }
        });

        await Transaction.create({
            userId: req.userId, type: 'wedding_ring',
            amount: { coins: -ring.price },
            balanceBefore: { coins: proposer.coins + ring.price, gems: proposer.gems },
            balanceAfter:  { coins: proposer.coins, gems: proposer.gems },
            description: `Proposal ring: ${ring.name}`, status: 'completed', completedAt: new Date()
        });

        // Notify partner
        const io = req.app.get('io');
        if (io) {
            io.to(`user:${partnerId}`).emit('wedding:proposal', {
                from: { _id: proposer._id, username: proposer.username, avatar: proposer.avatar },
                ring: wedding.ring, weddingId: wedding._id
            });
            io.to(`user:${req.userId}`).emit('balance_update', { coins: proposer.coins, gems: proposer.gems });
        }

        res.status(201).json({ success: true, wedding, message: `Proposal sent with ${ring.name}!` });
    } catch (error) { next(error); }
};

// @desc    Accept proposal
exports.acceptProposal = async (req, res, next) => {
    try {
        const { weddingId } = req.params;
        const wedding = await Wedding.findById(weddingId);
        if (!wedding) { const e = new Error('Wedding not found'); e.status = 404; throw e; }
        if (wedding.partnerId.toString() !== req.userId) { const e = new Error('Not your proposal'); e.status = 403; throw e; }
        if (wedding.status !== 'pending') { const e = new Error('Proposal no longer pending'); e.status = 400; throw e; }

        wedding.status    = 'active';
        wedding.marriedAt = new Date();
        await wedding.save();

        await wedding.populate([
            { path: 'proposerId', select: 'username avatar' },
            { path: 'partnerId',  select: 'username avatar' }
        ]);

        const io = req.app.get('io');
        if (io) {
            const payload = { weddingId: wedding._id, proposer: wedding.proposerId, partner: wedding.partnerId };
            io.to(`user:${wedding.proposerId._id}`).emit('wedding:accepted', payload);
            io.to(`user:${req.userId}`).emit('wedding:accepted', payload);
        }

        res.json({ success: true, wedding, message: '💍 Congratulations! You are now married!' });
    } catch (error) { next(error); }
};

// @desc    Reject proposal
exports.rejectProposal = async (req, res, next) => {
    try {
        const { weddingId } = req.params;
        const wedding = await Wedding.findById(weddingId);
        if (!wedding) { const e = new Error('Wedding not found'); e.status = 404; throw e; }
        if (wedding.partnerId.toString() !== req.userId) { const e = new Error('Not your proposal'); e.status = 403; throw e; }

        wedding.status = 'expired';
        await wedding.save();

        const io = req.app.get('io');
        if (io) io.to(`user:${wedding.proposerId}`).emit('wedding:rejected', { weddingId });

        res.json({ success: true, message: 'Proposal rejected' });
    } catch (error) { next(error); }
};

// @desc    Divorce
exports.divorce = async (req, res, next) => {
    try {
        const wedding = await Wedding.findOne({
            $or: [{ proposerId: req.userId }, { partnerId: req.userId }],
            status: 'active'
        });
        if (!wedding) { const e = new Error('No active marriage found'); e.status = 404; throw e; }

        const otherId = wedding.proposerId.toString() === req.userId ? wedding.partnerId : wedding.proposerId;
        wedding.status     = 'divorced';
        wedding.divorcedAt = new Date();
        await wedding.save();

        const io = req.app.get('io');
        if (io) {
            io.to(`user:${otherId}`).emit('wedding:divorced', { weddingId: wedding._id });
        }

        res.json({ success: true, message: 'Divorce completed' });
    } catch (error) { next(error); }
};

// @desc    Add blessing to ceremony
exports.addBlessing = async (req, res, next) => {
    try {
        const { weddingId } = req.params;
        const { message }   = req.body;
        const wedding = await Wedding.findById(weddingId);
        if (!wedding || wedding.status !== 'active') { const e = new Error('Wedding not found or not active'); e.status = 404; throw e; }

        const user = await User.findById(req.userId).select('username avatar');
        wedding.ceremony.blessings.push({ userId: req.userId, message: message || '💕' });
        wedding.ceremony.guestCount++;
        wedding.stats.totalBlessings++;
        await wedding.save();

        const io = req.app.get('io');
        if (io) {
            const payload = { from: user, message, weddingId };
            [wedding.proposerId, wedding.partnerId].forEach(uid =>
                io.to(`user:${uid}`).emit('wedding:blessing', payload));
        }

        res.json({ success: true, message: 'Blessing sent!' });
    } catch (error) { next(error); }
};

