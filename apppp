            .select('username avatar level vipLevel stats badges')
            .limit(parseInt(limit))
            .skip((parseInt(page) - 1) * parseInt(limit));

        const total = await User.countDocuments(query);
        res.json({
            users,
            total,
            page: parseInt(page),
            hasMore: (parseInt(page) * parseInt(limit)) < total
        });
    } catch (error) {
        next(error);
    }
};

