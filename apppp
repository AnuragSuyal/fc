  void _rallyFans() {
    Navigator.pop(context);
    // Emit rally event
    SocketService.socket?.emit('room:rally_fans', {
      'roomId': _room.id,
      'roomName': _room.name,
    });

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('Rallying fans... followers have been notified!'),
        backgroundColor: Colors.pinkAccent,
      ),
    );
  }

