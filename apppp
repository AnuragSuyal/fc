  String? _error;

  @override
  void initState() {
    super.initState();
    _checkPermissionAndLoad();
  }

  Future<void> _checkPermissionAndLoad() async {
    setState(() {
      _isLoading = true;
      _error = null;
    });

    try {
      // Check permission
      final hasPerm = await LocationService.hasPermission();

      if (!hasPerm) {
        setState(() {
          _hasPermission = false;
          _isLoading = false;
        });
        return;
      }

      setState(() => _hasPermission = true);

      // Get current location
      final location = await LocationService.getCurrentLocation();

      if (location == null) {
        setState(() {
          _error = 'Could not get location';
          _isLoading = false;
        });
        return;
      }

      // Removed _currentLocation storage

      // Update location on server
      await LocationService.updateLocation(
        latitude: location.latitude,
        longitude: location.longitude,
        sharing: true,
        radius: _maxDistance.toInt(),
      );

      // Get nearby users
      await _loadNearbyUsers();
    } catch (e) {
      setState(() {
        _error = e.toString();
        _isLoading = false;
      });
    }
  }

  Future<void> _loadNearbyUsers() async {
    setState(() => _isLoading = true);

    final users = await LocationService.getNearbyUsers(
      maxDistance: _maxDistance.toInt(),
    );

    if (!mounted) return;

    setState(() {
      _nearbyUsers = users;
      _isLoading = false;
    });
  }

  Future<void> _requestPermission() async {
    final granted = await LocationService.requestPermission();

    if (granted && mounted) {
      _checkPermissionAndLoad();
    } else {
      setState(() => _hasPermission = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Nearby'),
        actions: [
          // Distance filter
          PopupMenuButton<double>(
            icon: const Icon(Icons.filter_list),
            onSelected: (value) {
              setState(() => _maxDistance = value);
              _loadNearbyUsers();
            },
            itemBuilder: (context) => [
              const PopupMenuItem(value: 5, child: Text('5 km')),
              const PopupMenuItem(value: 10, child: Text('10 km')),
              const PopupMenuItem(value: 25, child: Text('25 km')),
              const PopupMenuItem(value: 50, child: Text('50 km')),
            ],
          ),
        ],
      ),
      body: _isLoading
          ? const Center(child: CircularProgressIndicator())
          : !_hasPermission
              ? _buildPermissionRequest()
              : _error != null
                  ? _buildError()
                  : _nearbyUsers.isEmpty
                      ? _buildEmptyState()
                      : _buildNearbyList(),
    );
  }

