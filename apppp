      backgroundColor: Colors.transparent,
      builder: (context) => ReactionQuickPanel(
        onSelectEmoji: (emoji) {
          final now = DateTime.now();
          if (_lastReactionTime != null &&
              now.difference(_lastReactionTime!) <
                  const Duration(milliseconds: 500)) {
            // Cooldown active
            return;
          }
          _lastReactionTime = now;

          final user = Provider.of<AuthProvider>(context, listen: false).user;
          if (user != null) {
            HapticFeedback.lightImpact();
            debugPrint(
                'ðŸ“¤ Emitting reaction: $emoji for seat ${_getUserSeatIndex(user.id)}');
            SocketService.socket?.emit('room:reaction', {
              'roomId': _room.id,
              'userId': user.id,
              'emoji': emoji,
              'seatIndex': _getUserSeatIndex(user.id),
            });
          }
        },
      ),
    );
  }

  int _getUserSeatIndex(String userId) {
    if (userId == _room.hostId) return 0;
    final nonHosts =
        _room.participants.where((p) => p.userId != _room.hostId).toList();
    final index = nonHosts.indexWhere((p) => p.userId == userId);
    return index != -1 ? index + 1 : -1;
  }

