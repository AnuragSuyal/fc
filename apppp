import 'dart:convert';
import 'package:flutter/foundation.dart';
import 'package:http/http.dart' as http;
import '../utils/constants.dart';
import 'auth_service.dart';

class ApiService {
  static const Duration _timeout = Duration(seconds: 20);

  static String get baseUrl => AppConfig.baseUrl;

  static Future<dynamic> get(String endpoint) async {
    try {
      final token    = await AuthService.getToken();
      final response = await http.get(
        Uri.parse('$baseUrl$endpoint'),
        headers: _headers(token),
      ).timeout(_timeout);
      return _handleResponse(response);
    } catch (e) { debugPrint('GET $endpoint Error: $e'); _rethrow(e); }
  }

  static Future<dynamic> post(String endpoint, Map<String, dynamic> data) async {
    try {
      final token    = await AuthService.getToken();
      final response = await http.post(
        Uri.parse('$baseUrl$endpoint'),
        headers: _headers(token),
        body: json.encode(data),
      ).timeout(_timeout);
      return _handleResponse(response);
    } catch (e) { debugPrint('POST $endpoint Error: $e'); _rethrow(e); }
  }

  static Future<dynamic> put(String endpoint, Map<String, dynamic> data) async {
    try {
      final token    = await AuthService.getToken();
      final response = await http.put(
        Uri.parse('$baseUrl$endpoint'),
        headers: _headers(token),
        body: json.encode(data),
      ).timeout(_timeout);
      return _handleResponse(response);
    } catch (e) { debugPrint('PUT $endpoint Error: $e'); _rethrow(e); }
  }

  static Future<dynamic> patch(String endpoint, Map<String, dynamic> data) async {
    try {
      final token    = await AuthService.getToken();
      final response = await http.patch(
        Uri.parse('$baseUrl$endpoint'),
        headers: _headers(token),
        body: json.encode(data),
      ).timeout(_timeout);
      return _handleResponse(response);
    } catch (e) { debugPrint('PATCH $endpoint Error: $e'); _rethrow(e); }
  }

  static Future<dynamic> delete(String endpoint) async {
    try {
      final token    = await AuthService.getToken();
      final response = await http.delete(
        Uri.parse('$baseUrl$endpoint'),
        headers: _headers(token),
      ).timeout(_timeout);
      return _handleResponse(response);
    } catch (e) { debugPrint('DELETE $endpoint Error: $e'); _rethrow(e); }
  }

  static Map<String, String> _headers(String? token) => {
    'Content-Type': 'application/json',
    if (token != null) 'Authorization': 'Bearer $token',
  };

  static dynamic _handleResponse(http.Response response) {
    if (response.statusCode >= 200 && response.statusCode < 300) {
      if (response.body.isEmpty) return null;
      try { return json.decode(response.body); } catch (_) { return response.body; }
    }
    try {
      final body = json.decode(response.body);
      String msg = 'Server error: ${response.statusCode}';
      if (body is Map) {
        if (body['error'] is Map)         msg = body['error']['message'] ?? msg;
        else if (body['error'] is String) msg = body['error'];
        else if (body['message'] is String) msg = body['message'];
      }
      if (response.statusCode == 401) AuthService.logout();
      throw Exception(msg);
    } catch (e) {
      if (e is Exception) rethrow;
      throw Exception('Server error: ${response.statusCode}');
    }
  }

  static Never _rethrow(Object e) {
    if (e is Exception) throw e;
    throw Exception('Network error: $e');
  }
}





