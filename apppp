class TimerScreen extends StatefulWidget {
  final String roomId;

  const TimerScreen({super.key, required this.roomId});

  @override
  State<TimerScreen> createState() => _TimerScreenState();
}

class _TimerScreenState extends State<TimerScreen> {
  static const int workDuration = 25 * 60; // 25 minutes
  static const int breakDuration = 5 * 60; // 5 minutes

  int _remainingSeconds = workDuration;
  bool _isRunning = false;
  bool _isWorkMode = true;
  Timer? _timer;

  int _workSessions = 0;

  @override
  void initState() {
    super.initState();
    _setupListeners();
  }

  void _setupListeners() {
    // TODO: Setup socket listeners for timer sync
  }

  void _startTimer() {
    if (_isRunning) return;

    setState(() => _isRunning = true);

    _timer = Timer.periodic(const Duration(seconds: 1), (timer) {
      setState(() {
        if (_remainingSeconds > 0) {
          _remainingSeconds--;
        } else {
          _switchMode();
        }
      });
    });

    // TODO: Emit socket event
  }

  void _pauseTimer() {
    setState(() => _isRunning = false);
    _timer?.cancel();
    // TODO: Emit socket event
  }

  void _resetTimer() {
    _timer?.cancel();
    setState(() {
      _isRunning = false;
      _remainingSeconds = _isWorkMode ? workDuration : breakDuration;
    });
    // TODO: Emit socket event
  }

  void _switchMode() {
    _timer?.cancel();
    setState(() {
      _isWorkMode = !_isWorkMode;
      _remainingSeconds = _isWorkMode ? workDuration : breakDuration;
      _isRunning = false;

      if (!_isWorkMode) {
        _workSessions++;
      }
    });
    // TODO: Emit socket event
  }

  String _formatTime(int seconds) {
    final minutes = seconds ~/ 60;
    final remainingSeconds = seconds % 60;
    return '${minutes.toString().padLeft(2, '0')}:${remainingSeconds.toString().padLeft(2, '0')}';
