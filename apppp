import 'package:flutter/material.dart';
import 'dart:async';
import 'dart:math';
import '../../services/socket_service.dart';
import 'floating_reaction.dart';

class ReactionAnimationOverlay extends StatefulWidget {
  final Map<int, GlobalKey> seatKeys;

  const ReactionAnimationOverlay({
    super.key,
    required this.seatKeys,
  });

  @override
  State<ReactionAnimationOverlay> createState() =>
      _ReactionAnimationOverlayState();
}

class _ReactionAnimationOverlayState extends State<ReactionAnimationOverlay> {
  final List<_PendingReaction> _reactions = [];
  StreamSubscription? _subscription;
  StreamSubscription? _messageSubscription;
  StreamSubscription? _soundSubscription;

  static const Map<String, String> _soundToEmoji = {
    'clap': 'ðŸ‘',
    'laugh': 'ðŸ˜‚',
    'cheer': 'ðŸŽ‰',
    'wow': 'ðŸ˜®',
    'kick': 'ðŸ¥',
    'bell': 'ðŸ””',
    'whistle': 'ðŸ˜—',
    'airhorn': 'ðŸ“¢',
  };

  @override
  void initState() {
    super.initState();
    _subscription = SocketService.reactionStream.listen((data) {
      _triggerReaction(data);
    });

    _messageSubscription = SocketService.roomMessageStream.listen((data) {
      if (data['type'] == 'emoji' && data['emojis'] != null) {
        final List<String> emojis = List<String>.from(data['emojis']);
        final userId = data['userId'];

        // Find seat index for this user
        // Note: For full accuracy, we'd pass the room model or a seat map,
        // but for now we'll assume the data contains it or we infer it.
        // If seatIndex is missing, we try to find it.
        final int seatIndex = data['seatIndex'] ?? -1;

        for (final emoji in emojis) {
          _triggerReaction({
            'emoji': emoji,
            'seatIndex': seatIndex,
            'userId': userId,
          });
        }
      }
    });

    _soundSubscription = SocketService.soundStream.listen((data) {
      final String? soundId = data['soundId'];
      final String emoji = _soundToEmoji[soundId] ?? 'ðŸŽµ';
      final int seatIndex = data['seatIndex'] ?? -1;

      if (seatIndex != -1) {
        _triggerReaction({
          'emoji': emoji,
          'seatIndex': seatIndex,
        });
      }
    });
  }

  void _triggerReaction(Map<String, dynamic> data) {
    if (!mounted) return;

    final int seatIndex = data['seatIndex'] ?? -1;
    if (seatIndex == -1) return;

    final key = widget.seatKeys[seatIndex];
    if (key == null || key.currentContext == null) return;

    final RenderBox box = key.currentContext!.findRenderObject() as RenderBox;
    final RenderBox? overlayBox = context.findRenderObject() as RenderBox?;
    if (overlayBox == null) return;

    final Offset center = box.localToGlobal(
      Offset(box.size.width / 2, box.size.height / 2),
      ancestor: overlayBox,
    );

    final random = Random();
    final jitter = Offset(
      random.nextDouble() * 30 - 15,
      random.nextDouble() * 30 - 15,
    );

    setState(() {
      _reactions.add(_PendingReaction(
        id: DateTime.now().microsecondsSinceEpoch.toString() +
            data['emoji'] +
            random.nextInt(1000).toString(),
        emoji: data['emoji'] ?? 'ðŸ”¥',
        position: center + jitter,
      ));
    });
  }

  @override
  void dispose() {
    _subscription?.cancel();
    _messageSubscription?.cancel();
    _soundSubscription?.cancel();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return IgnorePointer(
      child: RepaintBoundary(
        child: Stack(
          clipBehavior: Clip.none,
          children: _reactions.map((reaction) {
            return Positioned(
              left: reaction.position.dx - 20, // Center the 40px emoji
              top: reaction.position.dy - 20,
              child: FloatingReaction(
                key: ValueKey(reaction.id),
                emoji: reaction.emoji,
                onFinished: () {
                  if (mounted) {
                    setState(() {
                      _reactions.removeWhere((r) => r.id == reaction.id);
                    });
                  }
                },
              ),
            );
          }).toList(),
        ),
      ),
    );
  }
}

class _PendingReaction {
  final String id;
  final String emoji;
  final Offset position;

  _PendingReaction({
    required this.id,
    required this.emoji,
    required this.position,
  });
}







